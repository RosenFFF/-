# 复制为 .env 后填写。.env 已被 git 忽略；不提交、不贴真实密钥。
ENV=prod
DEMO_MODE=false

# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_KEK=
DATA_KEK_ID=k1
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 用户表为空时引导管理员；创建后删除这两项。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 本地联调也用 HTTPS（自签证书或本地反向代理），保持同一 hostname。
# 不要关闭生产 Secure；白名单必须与浏览器发出的 Origin（含端口）一致。
COOKIE_SECURE=true
CORS_ORIGINS=["https://localhost:3000"]

# 无密钥时不会请求云端；全部不可用则 L3 规则模式，绝不返回虚构模型结果。
LLM_PROVIDER_CHAIN=["deepseek","qwen","ollama"]
# 本地 Ollama LLM 默认彻底禁用（不探测、不推理、不回退）；不影响 OCR/embedding/reranker。
LOCAL_MODEL_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=25
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048
LLM_MAX_INPUT_CHARS=60000
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_RESET_S=60
MODEL_PROBE_TIMEOUT_S=1

# 默认 feature-hash + token-overlap（明确标注非 BGE），不下载大模型。
# 安装 uv sync --extra bge、事先缓存权重，才启用真正的 BGE；只读取本地缓存。
HEAVY_MODELS_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 无云密钥的宿主机最小真实联调（不要改生产 Secure/CORS）：
# 先在回环启动 Ollama：OLLAMA_HOST=127.0.0.1:11434 OLLAMA_NO_CLOUD=1 ollama serve
# 再拉指令模型：ollama pull qwen2.5:1.5b
# 将上面的对应项改为（列表必须用 JSON）：
# LOCAL_MODEL_ENABLED=true
# LLM_PROVIDER_CHAIN=["ollama"]
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=0
# Compose 内仍用 http://ollama:11434；backend 启动可用 uvicorn --env-file ../.env。
# 条件真实链路：backend 下 RUN_OLLAMA_E2E=1 uv run pytest -q -s tests/test_m1b_realpath.py
# 公开出处摘要与合成测试规则同时索引，必须展示 security.rule_corpus/检索模式/免责声明。

# M2 Redis 滑动窗口（每分钟；均为正整数）
RL_LOGIN_PER_MIN=10
RL_AUTH_PER_MIN=30
RL_DEFAULT_PER_MIN=300
RL_UPLOAD_PER_MIN=20
RL_REVIEW_PER_MIN=10
RL_CHAT_PER_MIN=20
# Compose 由 migrate 服务先执行 alembic upgrade head；宿主机须先手动迁移并配置 DATABASE_URL。

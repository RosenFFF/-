# 复制为 .env 后填写。.env 已在 .gitignore 中，任何真实密钥都不要提交、不要贴群里。
ENV=prod
# 演示篡改审计日志时临时设为 true（仅 admin 可用）
DEMO_MODE=false

# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 生成方式：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_KEK=
DATA_KEK_ID=k1

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 首次启动在用户表为空时创建管理员；建好后删掉这两行
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 浏览器经 http://localhost 访问时 Secure cookie 仍可用；其他明文 HTTP 主机需改为 false（不推荐）
COOKIE_SECURE=true
CORS_ORIGINS=["http://localhost:3000"]

# M1 接入大模型时填写
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
